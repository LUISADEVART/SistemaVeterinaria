import java.time.LocalDate;
public  interface IActualizable{

    void actualizar(String campo, Object nuevoValor);
    void mostrarInfo();

    default boolean validarValor(Object valor){
        if(valor==null){
            System.out.println("El valor no puede ser nulo");
            return false
        }
        return true;
    }

    default void confirmarActualizacion(String campo) {
        System.out.println("✔ Campo '" + campo + "' actualizado correctamente.");
    }
}